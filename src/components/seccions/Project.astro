---
import TranslatedText from "../TranslatedText.svelte";
import ProjectsFilter from "../ProjectsFilter.svelte";
---

<section id="projects" class="projects-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <TranslatedText key="projectsTitle" fallback="Proyectos" client:load />
      </h2>
      <p class="section-subtitle">
        Sistemas distribuidos, arquitecturas local-first, IA en el Edge y plataformas SaaS en producción.
      </p>
    </div>
    
    <ProjectsFilter client:load />
  </div>
</section>

<style>
  .projects-section {
    padding: 6rem 0;
    position: relative;
    background: radial-gradient(circle at 50% 0%, rgba(var(--primary-rgb), 0.04) 0%, transparent 60%);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 2.75rem;
    margin-bottom: 0.75rem;
    background: linear-gradient(to right, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .projects-section {
      padding: 4rem 0;
    }
    .section-title {
      font-size: 2.1rem;
    }
    .section-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
