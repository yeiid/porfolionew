---
import TranslatedText from "../TranslatedText.svelte";

interface ExperienceItem {
  id: string;
  roleKey: string;
  company: string;
  period: string;
  location?: string;
  descKey: string;
  icon: string;
  tags: string[];
  badge?: string;
}

interface EducationItem {
  id: string;
  titleKey: string;
  institution: string;
  period: string;
  duration?: string;
  descKey: string;
  icon: string;
  tags: string[];
  badge?: string;
}

const experiences: ExperienceItem[] = [
  {
    id: "neuraljira",
    roleKey: "expNeuraljiraTitle",
    company: "NeuralJIRA Studio",
    period: "2024 - Presente",
    location: "Bogotá, Colombia",
    descKey: "expNeuraljiraDesc",
    icon: "🚀",
    tags: ["SaaS Multi-Tenant", "Next.js", "Astro", "Go", "Docker"],
    badge: "Founder / Lead"
  },
  {
    id: "freelance-ecotech",
    roleKey: "expFreelanceDevTitle",
    company: "Freelance & Proyectos Propios",
    period: "2020 - 2024",
    location: "Colombia",
    descKey: "expFreelanceDevDesc",
    icon: "💻",
    tags: ["Python / Flask", "Flutter", "Offline-First", "SQLite", "IoT"],
    badge: "Tech for Good"
  },
  {
    id: "sodef",
    roleKey: "expSodefTitle",
    company: "SODEF SAS",
    period: "9 meses",
    descKey: "expSodefDesc",
    icon: "🏭",
    tags: ["Gestión Técnica", "Seguridad Química", "Salud Pública"],
    badge: "Técnico"
  },
  {
    id: "servi170",
    roleKey: "expServiTitle",
    company: "SERVI170 SAS",
    period: "1 año 3 meses",
    location: "Bogotá",
    descKey: "expServiDesc",
    icon: "🔧",
    tags: ["Maquinaria Automotriz", "Balanceo", "Calibración"],
    badge: "Operario"
  }
];

const educations: EducationItem[] = [
  {
    id: "oracle-one",
    titleKey: "eduOneTitle",
    institution: "Oracle + Alura Latam",
    period: "Octubre 2023 - Diciembre 2023",
    duration: "331 horas · 6 formaciones",
    descKey: "eduOneDesc",
    icon: "☕",
    tags: ["Java", "Spring Boot", "SQL Relacional", "POO"],
    badge: "Oracle Certified"
  },
  {
    id: "mision-tic",
    titleKey: "eduMisionTicTitle",
    institution: "MinTIC × Universidad Pontificia Bolivariana",
    period: "Junio 2021 - Diciembre 2021",
    duration: "600 horas de intensidad",
    descKey: "eduMisionTicDesc",
    icon: "🏛️",
    tags: ["Desarrollo de Software", "Python", "Java", "Algoritmos"],
    badge: "MinTIC & UPB"
  },
  {
    id: "sena",
    titleKey: "eduSenaTitle",
    institution: "SENA - Centro Agroempresarial y Acuícola",
    period: "Abril 2018 - Abril 2020 (Título 2022)",
    duration: "Carrera Tecnológica",
    descKey: "eduSenaDesc",
    icon: "🌿",
    tags: ["Gestión de Recursos", "Sistemas", "Datos Ecológicos"],
    badge: "Tecnólogo SENA"
  },
  {
    id: "bachiller",
    titleKey: "eduBachillerTitle",
    institution: "I.E. Nuestra Señora del Carmen (Hatonuevo, La Guajira)",
    period: "Febrero 2010 - Diciembre 2016",
    duration: "Educación Media",
    descKey: "eduBachillerDesc",
    icon: "🎓",
    tags: ["Bachiller Académico", "Hatonuevo"],
    badge: "Bachiller"
  }
];

const journeyEvents = [
  { year: "2014", titleKey: "journey2014Title", descKey: "journey2014Desc", icon: "💡", color: "var(--accent)" },
  { year: "2015", titleKey: "journey2015Title", descKey: "journey2015Desc", icon: "🐍", color: "var(--electric)" },
  { year: "2016", titleKey: "journey2016Title", descKey: "journey2016Desc", icon: "🎓", color: "var(--green)" },
  { year: "2017", titleKey: "journey2017Title", descKey: "journey2017Desc", icon: "🔬", color: "var(--green)" },
  { year: "2018", titleKey: "journey2018Title", descKey: "journey2018Desc", icon: "📚", color: "var(--electric)" },
  { year: "2020", titleKey: "journey2020Title", descKey: "journey2020Desc", icon: "⚡", color: "var(--accent)" },
  { year: "2021", titleKey: "journey2021Title", descKey: "journey2021Desc", icon: "🏛️", color: "var(--brand-cyan)" },
  { year: "2023", titleKey: "journey2023Title", descKey: "journey2023Desc", icon: "☕", color: "var(--electric)" },
  { year: "2024", titleKey: "journey2024Title", descKey: "journey2024Desc", icon: "🚀", color: "var(--accent)" },
  { year: "2025", titleKey: "journey2025Title", descKey: "journey2025Desc", icon: "🤖", color: "var(--brand-cyan)" },
  { year: "2026", titleKey: "journey2026Title", descKey: "journey2026Desc", icon: "🎯", color: "var(--green)" },
];
---

<section id="certifications" class="certifications-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <TranslatedText key="careerTitle" fallback="Trayectoria" client:load />
      </h2>
      <p class="section-subtitle">
        Experiencia laboral comprobada, certificaciones oficiales y mi evolución técnica continua.
      </p>
    </div>
    
    <div class="slider">
      <input type="radio" name="career-slider" id="slide-experience" checked>
      <input type="radio" name="career-slider" id="slide-education">
      <input type="radio" name="career-slider" id="slide-journey">
      
      <div class="slider-nav">
        <label for="slide-experience" class="nav-btn">
          <span class="btn-icon">💼</span>
          <TranslatedText key="experience" fallback="Experiencia" client:load />
          <span class="badge-count">{experiences.length}</span>
        </label>
        <label for="slide-education" class="nav-btn">
          <span class="btn-icon">🎓</span>
          <TranslatedText key="education" fallback="Educación" client:load />
          <span class="badge-count">{educations.length}</span>
        </label>
        <label for="slide-journey" class="nav-btn">
          <span class="btn-icon">🧭</span>
          <TranslatedText key="journeyTab" fallback="Mi Camino" client:load />
          <span class="badge-count">{journeyEvents.length}</span>
        </label>
      </div>
      
      <div class="slides">
        <!-- Slide 1: Experience -->
        <div class="slide slide-cards">
          <div class="cards-grid">
            {experiences.map((exp, index) => (
              <article class="trajectory-card" style={`--delay: ${index * 0.1}s`}>
                {exp.badge && (
                  <span class="card-badge exp-badge">{exp.badge}</span>
                )}
                
                <header class="card-top">
                  <div class="icon-box">
                    <span class="item-icon">{exp.icon}</span>
                  </div>
                  <div class="card-main-meta">
                    <h3 class="item-title">
                      <TranslatedText key={exp.roleKey} fallback={exp.roleKey} client:load />
                    </h3>
                    <h4 class="item-entity">{exp.company}</h4>
                  </div>
                </header>

                <div class="meta-row">
                  <span class="meta-pill period-pill">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="meta-icon">
                      <path fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z" clip-rule="evenodd" />
                    </svg>
                    {exp.period}
                  </span>
                  {exp.location && (
                    <span class="meta-pill location-pill">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="meta-icon">
                        <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.742 11.742 0 001.04 572l.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" />
                      </svg>
                      {exp.location}
                    </span>
                  )}
                </div>

                <p class="item-description">
                  <TranslatedText key={exp.descKey} fallback="" client:load />
                </p>

                <div class="tags-container">
                  {exp.tags.map(tag => (
                    <span class="tech-tag">{tag}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
        
        <!-- Slide 2: Education & Certifications -->
        <div class="slide slide-cards">
          <div class="cards-grid">
            {educations.map((edu, index) => (
              <article class="trajectory-card edu-card" style={`--delay: ${index * 0.1}s`}>
                {edu.badge && (
                  <span class="card-badge edu-badge">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="badge-icon">
                      <path fill-rule="evenodd" d="M16.403 12.652a3 3 0 000-5.304 3 3 0 00-3.75-3.751 3 3 0 00-5.305 0 3 3 0 00-3.751 3.75 3 3 0 000 5.305 3 3 0 003.75 3.751 3 3 0 005.305 0 3 3 0 003.751-3.75zm-2.546-4.46a.75.75 0 00-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                    {edu.badge}
                  </span>
                )}
                
                <header class="card-top">
                  <div class="icon-box edu-icon-box">
                    <span class="item-icon">{edu.icon}</span>
                  </div>
                  <div class="card-main-meta">
                    <h3 class="item-title">
                      <TranslatedText key={edu.titleKey} fallback={edu.titleKey} client:load />
                    </h3>
                    <h4 class="item-entity">{edu.institution}</h4>
                  </div>
                </header>

                <div class="meta-row">
                  <span class="meta-pill period-pill">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="meta-icon">
                      <path fill-rule="evenodd" d="M5.75 2a.75.75 0 01.75.75V4h7V2.75a.75.75 0 011.5 0V4h.25A2.75 2.75 0 0118 6.75v8.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25v-8.5A2.75 2.75 0 014.75 4H5V2.75A.75.75 0 015.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z" clip-rule="evenodd" />
                    </svg>
                    {edu.period}
                  </span>
                  {edu.duration && (
                    <span class="meta-pill duration-pill">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="meta-icon">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
                      </svg>
                      {edu.duration}
                    </span>
                  )}
                </div>

                <p class="item-description">
                  <TranslatedText key={edu.descKey} fallback="" client:load />
                </p>

                <div class="tags-container">
                  {edu.tags.map(tag => (
                    <span class="tech-tag">{tag}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Slide 3: Journey Timeline -->
        <div class="slide slide-journey">
          <div class="journey-timeline">
            {journeyEvents.map((event, index) => (
              <div class="journey-item" style={`--delay: ${index * 0.06}s; --event-color: ${event.color}`}>
                <div class="journey-dot">
                  <span class="journey-icon">{event.icon}</span>
                </div>
                <div class="journey-card">
                  <span class="journey-year">{event.year}</span>
                  <h4 class="journey-title">
                    <TranslatedText key={event.titleKey} fallback="" client:load />
                  </h4>
                  <p class="journey-desc">
                    <TranslatedText key={event.descKey} fallback="" client:load />
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .certifications-section {
    padding: 6rem 1rem;
    position: relative;
    background: radial-gradient(circle at 50% 100%, rgba(var(--brand-cyan-rgb), 0.04) 0%, transparent 60%);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2.75rem;
    margin-bottom: 0.75rem;
    background: linear-gradient(to right, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Slider Navigation */
  .slider {
    position: relative;
    overflow: hidden;
  }

  .slider input {
    display: none;
  }

  .slider-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .nav-btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.6rem;
    border-radius: 9999px;
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--text);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 600;
    font-size: 0.95rem;
    font-family: var(--font-display);
  }

  .nav-btn:hover {
    transform: translateY(-2px);
    border-color: var(--brand-cyan);
    color: var(--white);
    box-shadow: 0 4px 14px rgba(var(--brand-cyan-rgb), 0.2);
  }

  .badge-count {
    background: rgba(var(--text-rgb), 0.1);
    color: var(--text);
    padding: 0.15rem 0.5rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  #slide-experience:checked ~ .slider-nav label[for="slide-experience"],
  #slide-education:checked ~ .slider-nav label[for="slide-education"],
  #slide-journey:checked ~ .slider-nav label[for="slide-journey"] {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
    color: var(--ink);
    border-color: transparent;
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.35);
  }

  #slide-experience:checked ~ .slider-nav label[for="slide-experience"] .badge-count,
  #slide-education:checked ~ .slider-nav label[for="slide-education"] .badge-count,
  #slide-journey:checked ~ .slider-nav label[for="slide-journey"] .badge-count {
    background: rgba(var(--ink-rgb), 0.25);
    color: var(--ink);
  }

  /* Slides */
  .slides {
    display: flex;
    width: 300%;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #slide-education:checked ~ .slides {
    transform: translateX(-33.333%);
  }

  #slide-journey:checked ~ .slides {
    transform: translateX(-66.666%);
  }

  .slide {
    width: 33.333%;
    padding: 0.5rem 1rem 2rem;
    box-sizing: border-box;
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  /* Trajectory Card */
  .trajectory-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    animation: cardEntrance 0.5s ease var(--delay) both;
  }

  @keyframes cardEntrance {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .trajectory-card:hover {
    transform: translateY(-5px);
    border-color: rgba(var(--brand-cyan-rgb), 0.4);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.3), 0 0 16px rgba(var(--brand-cyan-rgb), 0.15);
  }

  .trajectory-card.edu-card:hover {
    border-color: rgba(var(--electric-rgb), 0.5);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.3), 0 0 18px rgba(var(--electric-rgb), 0.2);
  }

  /* Card Badge */
  .card-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
  }

  .exp-badge {
    background: rgba(var(--accent-rgb), 0.15);
    color: var(--accent2);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
  }

  .edu-badge {
    background: rgba(var(--brand-cyan-rgb), 0.15);
    color: var(--brand-cyan);
    border: 1px solid rgba(var(--brand-cyan-rgb), 0.3);
  }

  .badge-icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  /* Card Top */
  .card-top {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-right: 5rem;
  }

  .icon-box {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .edu-icon-box {
    background: rgba(var(--brand-cyan-rgb), 0.1);
    border-color: rgba(var(--brand-cyan-rgb), 0.25);
  }

  .trajectory-card:hover .icon-box {
    transform: rotate(8deg) scale(1.08);
  }

  .card-main-meta {
    flex: 1;
  }

  .item-title {
    font-size: 1.15rem;
    color: var(--white);
    margin: 0 0 0.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .item-entity {
    font-size: 0.9rem;
    color: var(--accent);
    margin: 0;
    font-weight: 600;
  }

  .edu-card .item-entity {
    color: var(--brand-cyan);
  }

  /* Meta Row */
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: rgba(var(--ink-rgb), 0.6);
    border: 1px solid var(--border);
    color: var(--text);
  }

  .meta-icon {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--muted);
  }

  .period-pill {
    color: var(--light);
    font-weight: 500;
  }

  .duration-pill {
    color: var(--brand-cyan);
    border-color: rgba(var(--brand-cyan-rgb), 0.25);
  }

  /* Description */
  .item-description {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
    flex-grow: 1;
  }

  /* Tags */
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(var(--border-rgb), 0.6);
  }

  .tech-tag {
    background: rgba(var(--text-rgb), 0.08);
    color: var(--text);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.73rem;
    font-weight: 500;
  }

  /* Journey Timeline */
  .slide-journey {
    display: flex;
    justify-content: center;
  }

  .journey-timeline {
    position: relative;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .journey-timeline::before {
    content: '';
    position: absolute;
    left: 24px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--accent) 0%, var(--brand-cyan) 50%, var(--green) 100%);
    border-radius: 2px;
  }

  .journey-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding-left: 0.5rem;
    animation: timelineItemIn 0.5s ease var(--delay) both;
  }

  @keyframes timelineItemIn {
    from {
      opacity: 0;
      transform: translateX(-15px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .journey-dot {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--panel);
    border: 2px solid var(--event-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
    z-index: 2;
    box-shadow: 0 0 14px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s ease;
  }

  .journey-item:hover .journey-dot {
    transform: scale(1.15);
  }

  .journey-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
